# Profile configuration (single source of truth)
# Format: profile_name|budget_minutes_per_day|mac1,mac2,mac3
#
# budget_minutes: 0 = unlimited (no daily limit)
#
# ALL MACs across ALL profiles form the MAC allowlist.
# Only listed MACs get internet access; unknown devices are blocked.
# Profiles with budget 0 and no cron schedule = always allowed (adults, IoT).
# Disable MAC randomization on kids' devices so their real MAC is used.

# === Adults (unlimited, no schedule) ===
dad|0|CHANGEME:MAC1,CHANGEME:MAC2
mom|0|CHANGEME:MAC3,CHANGEME:MAC4

# === Household devices (unlimited, no schedule) ===
smart_tv|0|CHANGEME:MAC5
printer|0|CHANGEME:MAC6
nas|0|CHANGEME:MAC7

# === Kids (with budgets and schedules) ===
alice|120|CHANGEME:MAC8,CHANGEME:MAC9
bob|90|CHANGEME:MAC10,CHANGEME:MAC11
charlie|60|CHANGEME:MAC12,CHANGEME:MAC13